# Email for the enquiry form (app/api/enquiry/route.js).
#
# This is the form's ONLY send path — there is no WhatsApp fallback any more.
# If these are not set on the server, the form fails and offers a phone number
# instead. Set them before the site goes public.
#
# Copy to .env.local for development; set the same keys in cPanel under
# "Setup Node.js App" -> Environment variables for production. Never commit the
# password: .env*.local is gitignored, this example file is not.

# Gmail, not the Namecheap mailbox.
#
# mail.gigcottage.net refuses SMTP from outside Namecheap's network — ports
# 25/465/587 all time out from any other machine — so it cannot be tested or
# used from anywhere but the server itself. Gmail works from both, and its
# deliverability is better than shared-host mail with no SPF or DKIM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The mailbox that GENERATED the app password. An app password authenticates
# the account it came from, so a mismatch here returns 535 no matter how
# correct the password is.
SMTP_USER=gigtech2025@gmail.com

# A Google app password, 16 characters, no spaces. Requires 2-Step
# Verification on that account: Security -> App passwords -> Mail.
SMTP_PASS=

# Gmail will only send as the authenticated account, so this matches SMTP_USER.
# The enquirer's own address goes in Reply-To, set by the route, so replying
# reaches them and not this mailbox.
SMTP_FROM=gigtech2025@gmail.com

# Where enquiries land. Comma-separate for more than one.
#
#   production: cottagegig@gmail.com
#   testing:    your own address, in .env.local
#
# Deliberately blank here. There is no fallback in the route: an unset value
# fails loudly in the log rather than quietly mailing the client from a
# developer's machine.
ENQUIRY_TO=
